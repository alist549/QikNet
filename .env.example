# Store real values as encrypted deployment secrets. Never commit passwords.
QIKNET_EMAIL=
QIKNET_PASSWORD=
RUIJIE_EMAIL=
RUIJIE_PASSWORD=
SMSPOP_TOKEN=
STOCK_REPORT_RECIPIENT=
DEFAULT_OUTAGE_RECIPIENTS=
SPECIAL_OUTAGE_RECIPIENT=

# Safe by default. Set to false only after reviewing a successful dry run.
DRY_RUN=true

# Optional: comma-separated QikNet branch names for a limited test.
# SYNC_BRANCHES=Unit M

# Optional browser settings.
HEADLESS=true
ACTION_TIMEOUT_MS=20000
NAVIGATION_TIMEOUT_MS=45000

# Station monitor: false is useful for a manual read-only test.
SEND_SMS=false
